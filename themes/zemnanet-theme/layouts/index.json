{{- /*
  index.json — JSON feed for client-side search.
  Outputs an array of { url, title, summary, tags, categories, date }.
*/ -}}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ .Site.Title | jsonify }},
  "home_page_url": {{ .Site.BaseURL | jsonify }},
  "feed_url": {{ printf "%sindex.json" .Site.BaseURL | jsonify }},
  "language": {{ .Site.LanguageCode | jsonify }},
  "items": [
    {{- range $i, $p := where .Site.RegularPages "Section" "posts" }}
    {{- if $i }},{{ end }}
    {
      "id": {{ $p.Permalink | jsonify }},
      "url": {{ $p.Permalink | jsonify }},
      "title": {{ $p.Title | jsonify }},
      "summary": {{ $p.Description | default ($p.Summary | plainify | truncate 200) | jsonify }},
      "tags": {{ $p.Params.tags | default (slice) | jsonify }},
      "categories": {{ $p.Params.categories | default (slice) | jsonify }},
      "date_published": {{ $p.PublishDate.Format "2006-01-02T15:04:05Z07:00" | jsonify }}
    }
    {{- end }}
  ]
}
