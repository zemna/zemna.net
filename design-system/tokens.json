{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "zemnanet Design System",
  "version": "1.0.0",
  "description": "Design tokens for zemnanet — Korean ↔ Indonesia/SEA developer bridge. Used across zemna.net website, blog posts, social media, and any zemnanet-owned surfaces.",
  "owner": "zemnanet",
  "brand": {
    "name": "zemnanet",
    "tagline": "Bridging Korean & Southeast Asian Tech",
    "voice": "Senior Korean dev based in Jakarta, 15 years. Practical, terse, code-first. 한국어 + English + Bahasa mix.",
    "personas": ["zemna (IG)", "zemnanet (X)"]
  },

  "color": {
    "$description": "Brand palette. Navy = trust/structure, Off-white = calm paper, Vermilion = energy/highlight. Inspired by Korean hanji (off-white) and Indonesian batik (navy+vermilion).",

    "primary": {
      "navy": {
        "50":  { "value": "#EEF0F5", "description": "Subtle background tint" },
        "100": { "value": "#D4D8E3", "description": "Hover, secondary surface" },
        "200": { "value": "#A9B1C7", "description": "Disabled, muted text on dark" },
        "300": { "value": "#7E89AB", "description": "Tertiary text on light" },
        "400": { "value": "#53638F", "description": "Secondary text on light" },
        "500": { "value": "#2E4073", "description": "Body emphasis" },
        "600": { "value": "#1F2D57", "description": "Headings on light bg" },
        "700": { "value": "#1A2238", "value.css": "#1A2238", "description": "Brand navy — main brand" },
        "800": { "value": "#141A2B", "description": "Hover on navy" },
        "900": { "value": "#0D111F", "description": "Page background, dark surfaces" }
      },
      "vermilion": {
        "50":  { "value": "#FCEEEC", "description": "Subtle alert bg" },
        "100": { "value": "#F8D2CC", "description": "Hover" },
        "200": { "value": "#F2A499", "description": "Disabled accent" },
        "300": { "value": "#EC7666", "description": "Soft accent" },
        "400": { "value": "#E65A4A", "description": "Hover on accent" },
        "500": { "value": "#E34234", "value.css": "#E34234", "description": "Brand vermilion — CTA, links" },
        "600": { "value": "#C42B1F", "description": "Active" },
        "700": { "value": "#9F1F16", "description": "Strong accent" },
        "800": { "value": "#79160F", "description": "Alert text" },
        "900": { "value": "#540E0A", "description": "Critical" }
      }
    },
    "neutral": {
      "off-white": {
        "50":  { "value": "#FCFBF8", "value.css": "#FCFBF8", "description": "Brand off-white — main bg" },
        "100": { "value": "#F8F6F0", "description": "Card surface" },
        "200": { "value": "#F4F1EA", "value.css": "#F4F1EA", "description": "Subtle surface" },
        "300": { "value": "#E8E4DA", "description": "Border subtle" },
        "400": { "value": "#C9C3B5", "description": "Disabled" }
      },
      "ink": {
        "500": { "value": "#5B5750", "description": "Muted body" },
        "600": { "value": "#3D3A35", "description": "Body on light" },
        "700": { "value": "#26241F", "description": "Headings" },
        "800": { "value": "#181712", "description": "Strong body" }
      }
    },
    "semantic": {
      "success": { "value": "#3A7D44", "description": "Positive deltas, build passing" },
      "warning": { "value": "#D4922B", "description": "Caution, deprecated" },
      "danger":  { "value": "#C42B1F", "description": "Errors, breaking" },
      "info":    { "value": "#2E4073", "description": "Informational" }
    },

    "theme": {
      "light": {
        "bg":           { "value": "{color.neutral.off-white.50}", "description": "Page background" },
        "surface":      { "value": "{color.neutral.off-white.100}", "description": "Card/panel" },
        "border":       { "value": "{color.neutral.off-white.300}", "description": "Subtle borders" },
        "text":         { "value": "{color.neutral.ink.600}", "description": "Body" },
        "text-muted":   { "value": "{color.neutral.ink.500}", "description": "Captions, metadata" },
        "text-strong":  { "value": "{color.neutral.ink.700}", "description": "Headings" },
        "link":         { "value": "{color.primary.vermilion.500}", "description": "Inline links" },
        "link-hover":   { "value": "{color.primary.vermilion.600}", "description": "Hover" },
        "code-bg":      { "value": "{color.primary.navy.50}", "description": "Inline code" },
        "code-block-bg":{ "value": "{color.primary.navy.900}", "description": "Code blocks" },
        "code-block-fg":{ "value": "{color.neutral.off-white.100}", "description": "Code in blocks" }
      },
      "dark": {
        "bg":           { "value": "{color.primary.navy.900}", "description": "Page background" },
        "surface":      { "value": "{color.primary.navy.800}", "description": "Card/panel" },
        "border":       { "value": "{color.primary.navy.600}", "description": "Subtle borders" },
        "text":         { "value": "{color.neutral.off-white.100}", "description": "Body" },
        "text-muted":   { "value": "{color.neutral.off-white.300}", "description": "Captions" },
        "text-strong":  { "value": "{color.neutral.off-white.50}", "description": "Headings" },
        "link":         { "value": "{color.primary.vermilion.400}", "description": "Inline links" },
        "link-hover":   { "value": "{color.primary.vermilion.300}", "description": "Hover" },
        "code-bg":      { "value": "{color.primary.navy.700}", "description": "Inline code" },
        "code-block-bg":{ "value": "{color.primary.navy.700}", "description": "Code blocks" },
        "code-block-fg":{ "value": "{color.neutral.off-white.100}", "description": "Code in blocks" }
      }
    }
  },

  "typography": {
    "$description": "Inter for UI/Latin, JetBrains Mono for code, Noto Serif KR for editorial Korean. System stack fallback for performance.",

    "family": {
      "sans": {
        "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
        "description": "UI body, headings, navigation"
      },
      "serif": {
        "value": "'Noto Serif KR', 'Source Han Serif', 'Iowan Old Style', 'Apple Garamond', serif",
        "description": "Editorial long-form Korean content"
      },
      "mono": {
        "value": "'JetBrains Mono', 'Fira Code', 'SF Mono', Menlo, Consolas, monospace",
        "description": "Code, technical values, file paths"
      }
    },
    "weight": {
      "regular": { "value": 400 },
      "medium":  { "value": 500 },
      "semibold":{ "value": 600 },
      "bold":    { "value": 700 }
    },
    "size": {
      "xs":   { "value": "0.75rem",  "description": "12px — captions, micro labels" },
      "sm":   { "value": "0.875rem", "description": "14px — small UI, metadata" },
      "base": { "value": "1rem",     "description": "16px — body default" },
      "lg":   { "value": "1.125rem", "description": "18px — lead paragraphs" },
      "xl":   { "value": "1.25rem",  "description": "20px — h4" },
      "2xl":  { "value": "1.5rem",   "description": "24px — h3" },
      "3xl":  { "value": "1.875rem", "description": "30px — h2" },
      "4xl":  { "value": "2.25rem",  "description": "36px — h1 mobile" },
      "5xl":  { "value": "3rem",     "description": "48px — h1 desktop" },
      "6xl":  { "value": "3.75rem",  "description": "60px — hero display" }
    },
    "lineHeight": {
      "tight":  { "value": 1.2,  "description": "Headings" },
      "snug":   { "value": 1.35, "description": "Subheadings" },
      "normal": { "value": 1.6,  "description": "Body" },
      "relaxed":{ "value": 1.75, "description": "Long-form editorial" }
    },
    "letterSpacing": {
      "tight":   { "value": "-0.02em", "description": "Display headings" },
      "normal":  { "value": "0",       "description": "Body" },
      "wide":    { "value": "0.04em",  "description": "Eyebrow labels" },
      "widest":  { "value": "0.12em",  "description": "All-caps section labels" }
    }
  },

  "spacing": {
    "$description": "8px base scale. T-shirt sizes for component padding, px values for layout.",

    "0":   { "value": "0" },
    "1":   { "value": "0.25rem", "description": "4px" },
    "2":   { "value": "0.5rem",  "description": "8px" },
    "3":   { "value": "0.75rem", "description": "12px" },
    "4":   { "value": "1rem",    "description": "16px — base" },
    "5":   { "value": "1.25rem", "description": "20px" },
    "6":   { "value": "1.5rem",  "description": "24px" },
    "8":   { "value": "2rem",    "description": "32px" },
    "10":  { "value": "2.5rem",  "description": "40px" },
    "12":  { "value": "3rem",    "description": "48px" },
    "16":  { "value": "4rem",    "description": "64px — section gap" },
    "20":  { "value": "5rem",    "description": "80px" },
    "24":  { "value": "6rem",    "description": "96px — hero padding" },
    "32":  { "value": "8rem",    "description": "128px" }
  },

  "radius": {
    "none": { "value": "0" },
    "sm":   { "value": "2px",   "description": "Tags, chips" },
    "md":   { "value": "4px",   "description": "Buttons, inputs" },
    "lg":   { "value": "8px",   "description": "Cards" },
    "xl":   { "value": "12px",  "description": "Feature cards" },
    "2xl":  { "value": "16px",  "description": "Hero panels" },
    "full": { "value": "9999px","description": "Pills, avatars" }
  },

  "shadow": {
    "none": { "value": "none" },
    "xs":   { "value": "0 1px 2px rgba(26, 34, 56, 0.05)", "description": "Subtle elevation" },
    "sm":   { "value": "0 2px 4px rgba(26, 34, 56, 0.06), 0 1px 2px rgba(26, 34, 56, 0.04)" },
    "md":   { "value": "0 4px 12px rgba(26, 34, 56, 0.08), 0 2px 4px rgba(26, 34, 56, 0.04)" },
    "lg":   { "value": "0 12px 24px rgba(26, 34, 56, 0.10), 0 4px 8px rgba(26, 34, 56, 0.05)" },
    "xl":   { "value": "0 24px 48px rgba(26, 34, 56, 0.12), 0 8px 16px rgba(26, 34, 56, 0.06)" },
    "inner":{ "value": "inset 0 2px 4px rgba(26, 34, 56, 0.06)" }
  },

  "breakpoint": {
    "$description": "Mobile-first. sm=tablet portrait, md=tablet landscape, lg=desktop, xl=wide desktop.",
    "sm": { "value": "640px" },
    "md": { "value": "768px" },
    "lg": { "value": "1024px" },
    "xl": { "value": "1280px" },
    "2xl":{ "value": "1536px" }
  },

  "container": {
    "maxWidth": {
      "prose":  { "value": "68ch",   "description": "Article body — optimal reading" },
      "narrow": { "value": "640px",  "description": "Forms, single-column" },
      "default":{ "value": "1024px", "description": "Page content" },
      "wide":   { "value": "1280px", "description": "Dashboard, lists" },
      "full":   { "value": "1536px", "description": "Marketing, hero" }
    }
  },

  "motion": {
    "duration": {
      "instant": { "value": "0ms" },
      "fast":    { "value": "120ms", "description": "Hover, focus" },
      "normal":  { "value": "200ms", "description": "Most transitions" },
      "slow":    { "value": "320ms", "description": "Page transitions" },
      "deliberate": { "value": "480ms", "description": "Hero animations" }
    },
    "easing": {
      "linear":   { "value": "linear" },
      "out":      { "value": "cubic-bezier(0.16, 1, 0.3, 1)", "description": "Decelerate, soft landings" },
      "in":       { "value": "cubic-bezier(0.7, 0, 0.84, 0)", "description": "Accelerate" },
      "inOut":    { "value": "cubic-bezier(0.65, 0, 0.35, 1)", "description": "Symmetric" },
      "spring":   { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "description": "Subtle bounce" }
    }
  },

  "zIndex": {
    "base":     { "value": 0 },
    "raised":   { "value": 10 },
    "sticky":   { "value": 100 },
    "overlay":  { "value": 200 },
    "modal":    { "value": 300 },
    "popover":  { "value": 400 },
    "toast":    { "value": 500 },
    "tooltip":  { "value": 600 }
  },

  "iconography": {
    "library": "Lucide",
    "stroke": 1.5,
    "size": {
      "sm": 16,
      "md": 20,
      "lg": 24,
      "xl": 32
    }
  },

  "logo": {
    "primary": {
      "description": "Wordmark 'ZEMNA.NET' in D2Coding 700 with a compact developer handheld mark. The mark uses a green code screen, d-pad, and vermilion run button.",
      "mark":   { "value": "/favicon.svg" },
      "wordmark": { "value": "/zemnanet-logo.svg" }
    },
    "monogram": {
      "value": "zn",
      "description": "Fallback for favicons and tiny spaces. navy bg + off-white letterforms."
    }
  }
}
